[Unit]
Description=Geographic Reference Service
Wants=network-online.target
After=network-online.target

[Container]
Image=@@IMAGE@@
ContainerName=geographic-reference-service
Environment=QUARKUS_PROFILE=prod
EnvironmentFile=geographic-reference-service.env
Network=internal-services.network
Network=geographic-db.network
NetworkAlias=geographic-reference-service
PublishPort=127.0.0.1:8081:8080/tcp
Pull=never
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
PidsLimit=256
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=300
TimeoutStopSec=30
MemoryAccounting=true
MemoryMax=512M
CPUQuota=100%
TasksMax=256

[Install]
WantedBy=default.target
